# Environment Configuration Example
# Copy this file to .env.local and replace with your actual values

# Supabase Configuration
# Get these values from: https://supabase.com/dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# API Configuration
VITE_API_URL=http://localhost:3000

# Logging
VITE_LOG_LEVEL=debug

# AI APIs (OptiBot) - Optional
# Get Gemini API key from: https://console.cloud.google.com/
# Get Groq API key from: https://console.groq.com/
# Get OpenRouter API key from: https://openrouter.ai/
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=

# Feature Flags
VITE_ENABLE_OPTIBOT=true
VITE_ENABLE_ANALYTICS=false
